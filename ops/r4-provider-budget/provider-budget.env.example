# R4 provider budget check thresholds. Copy to ~/.config/r4/provider-budget.env; edits apply on the next run.
# Spend budgets from GET /key (workspace and key caps): percentage of the limit still available.
WARN_BUDGET_REMAINING_PCT=20
CRIT_BUDGET_REMAINING_PCT=5
# Days left at the current burn (the larger of today's spend and the weekly average). For a budget, only when it runs
# out before it resets; also for the account balance.
WARN_DAYS_LEFT=7
CRIT_DAYS_LEFT=2
# Account balance (US$, GET /credits). Optional: a key that may not read it is noted once, never warned about.
WARN_BALANCE_USD=5
CRIT_BALANCE_USD=1
# model.call.failed in the window. insufficient_balance and spend_limit_reached are always CRITICAL.
CHECK_WINDOW_MINUTES=60
# rate_limited = rate saturation (requests per minute). R4 retries it, the monitor counts it.
WARN_RATE_LIMITED=5
CRIT_RATE_LIMITED=50
WARN_PROVIDER_ERRORS=3
# Alerts: POST {"text", "status", "findings"} to this URL (Slack/Discord/Teams-compatible "text"); empty = log + exit
# code only. The URL is a secret and is never printed.
ALERT_WEBHOOK_URL=
ALERT_REPEAT_MINUTES=180
# Where the API key is read from (R4_MODEL_API_KEY / R4_MODEL_BASE_URL); the key is never printed.
# KEY_ENV_FILE=~/.config/r4/production.env
