# R4 provider budget check thresholds. Copy to ~/.config/r4/provider-budget.env; edits apply on the next run.
# Account balance (US$, whole OpenRouter account) and days left at the current burn rate.
WARN_BALANCE_USD=5
CRIT_BALANCE_USD=1
WARN_DAYS_LEFT=7
CRIT_DAYS_LEFT=2
# This key's own spend cap, if one is set in OpenRouter (percentage of the limit still available).
WARN_KEY_REMAINING_PCT=20
CRIT_KEY_REMAINING_PCT=5
# model.call.failed in the window (any quota_exhausted is always CRITICAL).
CHECK_WINDOW_MINUTES=60
WARN_PROVIDER_ERRORS=3
WARN_RATE_LIMITED=5
# Alerts: POST {"text", "status", "findings"} to this URL (Slack/Discord/Teams-compatible "text"); empty = log + exit code only.
ALERT_WEBHOOK_URL=
ALERT_REPEAT_MINUTES=180
# Where the API key is read from (R4_MODEL_API_KEY / R4_MODEL_BASE_URL); the key is never printed.
# KEY_ENV_FILE=~/.config/r4/production.env
