{
  "//": "Whole-repository typecheck (source-to-source, no emit). Build uses tsconfig.build.json project references.",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "paths": {
      "@r4/contracts": ["./packages/contracts/src/index.ts"],
      "@r4/observability": ["./packages/observability/src/index.ts"],
      "@r4/model-gateway": ["./packages/model-gateway/src/index.ts"],
      "@r4/policy-engine": ["./packages/policy-engine/src/index.ts"],
      "@r4/capability-runtime": ["./packages/capability-runtime/src/index.ts"],
      "@r4/task-runtime": ["./packages/task-runtime/src/index.ts"],
      "@r4/agent-registry": ["./packages/agent-registry/src/index.ts"],
      "@r4/persistence-postgres": ["./packages/persistence-postgres/src/index.ts"],
      "@r4/agent-kernel": ["./packages/agent-kernel/src/index.ts"],
      "@r4/context-compiler": ["./packages/context-compiler/src/index.ts"],
      "@r4/evaluation": ["./packages/evaluation/src/index.ts"],
      "@r4/evaluator": ["./apps/evaluator/src/index.ts"],
      "@r4/shadow": ["./packages/shadow/src/index.ts"],
      "@r4/live-ops": ["./packages/live-ops/src/index.ts"],
      "@r4/api": ["./apps/api/src/index.ts"],
      "@r4/worker": ["./apps/worker/src/index.ts"],
      "@r4/scheduler": ["./apps/scheduler/src/index.ts"],
      "@r4/channel-gateway": ["./apps/channel-gateway/src/index.ts"],
      "@r4-adapters/domains": ["./adapters/domains/src/index.ts"],
      "@r4-adapters/catalog-http": ["./adapters/domains/catalog/http/src/index.ts"],
      "@r4-adapters/openai-compatible": ["./adapters/models/openai-compatible/src/index.ts"],
      "@r4-adapters/whatsapp-cloud/testing": ["./adapters/channels/whatsapp-cloud/src/testing.ts"],
      "@r4-adapters/whatsapp-cloud": ["./adapters/channels/whatsapp-cloud/src/index.ts"],
      "@r4-sales/agent/evaluations": ["./agents/sales/src/evaluations/index.ts"],
      "@r4-sales/agent/shadow": ["./agents/sales/src/shadow/index.ts"],
      "@r4-sales/agent/production": ["./agents/sales/src/production/index.ts"],
      "@r4-sales/agent": ["./agents/sales/src/index.ts"]
    }
  },
  "include": ["packages/*/src", "apps/*/src", "adapters/domains/src", "adapters/domains/catalog/http/src", "adapters/models/*/src", "adapters/channels/*/src", "agents/sales/src", "tests", "vitest.config.ts", "eslint.config.js"]
}
