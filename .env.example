# Local development only. Never commit real credentials.
R4_DATABASE_URL=postgres://r4:r4_local_only@127.0.0.1:55432/r4
R4_HTTP_HOST=127.0.0.1
R4_HTTP_PORT=8080
R4_LOG_LEVEL=info
R4_AGENT_DEFINITIONS_DIR=./agents

# Integration tests create and drop throwaway databases through this admin URL.
R4_TEST_DATABASE_URL=postgres://r4:r4_local_only@127.0.0.1:55432/postgres

# R4-F: first real model provider (deployment configuration, never in an AgentDefinition).
# Leave R4_MODEL_PROVIDER unset for offline work: CI and scripted scenarios need no model.
# R4_MODEL_PROVIDER=openai_compatible
# R4_MODEL_BASE_URL=https://your-openai-compatible-endpoint/v1
# R4_MODEL_API_KEY=
# R4_MODEL_NAME=
# R4_MODEL_PROFILE=default
# R4_MODEL_CONTEXT_WINDOW_TOKENS=64000
# R4_MODEL_MAX_OUTPUT_TOKENS=2048
# R4_MODEL_TIMEOUT_MS=120000
