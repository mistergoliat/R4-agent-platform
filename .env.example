# Local development only. Never commit real credentials.
R4_DATABASE_URL=postgres://r4:r4_local_only@127.0.0.1:55432/r4
R4_HTTP_HOST=127.0.0.1
R4_HTTP_PORT=8080
R4_LOG_LEVEL=info
R4_AGENT_DEFINITIONS_DIR=./agents

# Integration tests create and drop throwaway databases through this admin URL.
R4_TEST_DATABASE_URL=postgres://r4:r4_local_only@127.0.0.1:55432/postgres

# R4-F: first real model provider (deployment configuration, never in an AgentDefinition).
# Leave R4_MODEL_PROVIDER unset for offline work: CI and scripted scenarios need no model.
# R4_MODEL_PROVIDER=openai_compatible
# R4_MODEL_BASE_URL=https://api.deepseek.com   (base URL only: the adapter appends /chat/completions)
# R4_MODEL_API_KEY=
# R4_MODEL_NAME=deepseek-v4-flash
# R4_MODEL_PROFILE=default
# R4_MODEL_CONTEXT_WINDOW_TOKENS=64000
# R4_MODEL_MAX_OUTPUT_TOKENS=2048
# R4_MODEL_TIMEOUT_MS=120000
# Extra top-level request fields as one JSON object (vendor switches; never credentials, it is reported).
# It cannot set fields the adapter owns (model, messages, max_tokens, stream, response_format, temperature, tools).
# e.g. DeepSeek, to make reasoning explicit instead of relying on the server default (thinking on):
# R4_MODEL_EXTRA_BODY={"thinking":{"type":"disabled"}}

# R4-J1B: Catalog HTTP adapter (catalog-service v2 read contract). All three are required; nothing defaults.
# NOT bound in production until catalog-service passes the R4-J1A integration gate; the production plan
# reports this configuration declaratively and never claims authentication or connectivity.
# R4_CATALOG_BASE_URL=http://127.0.0.1:4010   (a non-local URL requires https and R4_PROD_ALLOW_NETWORK=true)
# R4_CATALOG_API_KEY=                          (the key dedicated to R4; never printed)
# R4_CATALOG_TIMEOUT_MS=3000                   (100–10000; must stay below the capability timeout of 10000)
