{
  "$ref": "#/definitions/DiscoverAgentRequest",
  "definitions": {
    "DiscoverAgentRequest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "need": {
          "type": "string",
          "minLength": 1,
          "description": "The product need in the customer's words, consolidated by the caller (never the conversation, never customer data)."
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8,
          "description": "Verified candidates to return; never clamped."
        },
        "constraints": {
          "type": "object",
          "properties": {
            "maxUnitPriceClp": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100000000,
              "description": "Unit price <= X CLP, tax included; reference prices never satisfy it."
            },
            "sellableOnly": {
              "type": "boolean"
            },
            "minUserCapacityKg": {
              "type": "number",
              "minimum": 1,
              "maximum": 2000
            },
            "minLoadKg": {
              "type": "number",
              "minimum": 1,
              "maximum": 5000
            },
            "maxLengthCm": {
              "type": "number",
              "minimum": 1,
              "maximum": 2000
            },
            "maxWidthCm": {
              "type": "number",
              "minimum": 1,
              "maximum": 2000
            },
            "maxHeightCm": {
              "type": "number",
              "minimum": 1,
              "maximum": 2000
            }
          },
          "additionalProperties": false
        },
        "hints": {
          "type": "object",
          "properties": {
            "productKeys": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^P[1-9]\\d{0,9}$"
              },
              "maxItems": 8
            }
          },
          "additionalProperties": false
        },
        "selectedItemKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^P\\d+(?:-V\\d+)?$"
          },
          "maxItems": 8,
          "description": "Sellable units the customer already chose (owner itemKeys)."
        },
        "context": {
          "type": "object",
          "properties": {
            "correlationId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9._:-]{1,64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "need"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
